{$PUBLIC_HOST:localhost} {
  encode gzip
  handle /auth/* { reverse_proxy api:3000 }
  handle /households* { reverse_proxy api:3000 }
  handle /invites/* { reverse_proxy api:3000 }
  handle /health { reverse_proxy api:3000 }
  handle /status { reverse_proxy api:3000 }
  handle /metrics { reverse_proxy api:3000 }
  handle /admin/* { reverse_proxy api:3000 }
  handle /docs* { reverse_proxy api:3000 }
  handle { root * /srv; try_files {path} /index.html; file_server }
  header { Strict-Transport-Security "max-age=31536000" X-Content-Type-Options nosniff Referrer-Policy no-referrer }
}
