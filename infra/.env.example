# copy to infra/.env
POSTGRES_PASSWORD=change-me
SESSION_SECRET=generate-a-long-random-string-at-least-32-chars
PUBLIC_HOST=localhost
PUBLIC_ORIGIN=https://localhost
# Mail: console (default, prints to the API log) or smtp
MAIL_TRANSPORT=console
SMTP_URL=smtps://user:password@smtp.example.com:465
MAIL_FROM=OnePlate <no-reply@example.com>

# Comma-separated account emails that may use /admin routes and review content (the scholar review workflow)
ADMIN_EMAILS=
