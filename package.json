{
  "name": "oneplate",
  "private": true,
  "version": "0.1.0",
  "packageManager": "pnpm@10.28.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "node scripts/build-app.mjs && pnpm -r --filter ./packages/* --filter ./apps/* build",
    "build:app": "node scripts/build-app.mjs",
    "check:app": "node scripts/build-app.mjs --check",
    "test": "pnpm -r test",
    "typecheck": "pnpm -r typecheck",
    "dev:api": "pnpm --filter @oneplate/api dev",
    "dev:web": "pnpm --filter @oneplate/web dev",
    "migrate": "pnpm --filter @oneplate/api migrate"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "esbuild": "~0.24.2",
    "tsx": "^4.19.2",
    "typescript": "^5.6.3",
    "vitest": "^2.1.8"
  }
}
